#        bool keys / NaN break encoding/json?

final_boss: &boss
  yes: no
  no: yes
  on: off
  off: on
  y: n
  n: y
  YES: NO
  NO: YES
  true: false
  false: true
  ON: OFF
  OFF: ON
  True: False
  False: True
  TRUE: FALSE
  FALSE: TRUE

  010: 0x10
  0o10: 0b10
  12:34: 1.0e+3
  -0: .inf
  .nan: -.Inf
  00: +0
  1.0: 1
  1: 1.0

  2026-08-09: 12:34:56

  ~: null
  null: ~
  "": ~
  Null: NULL

  "<<": not-merge-just-string

  nested:
    <<: *boss
    survivor: true
